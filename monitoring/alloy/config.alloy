discovery.kubernetes "pods" {
  role = "pod"
}

loki.source.kubernetes "pods" {
  targets    = discovery.kubernetes.pods.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki-amine-gateway.monitoring-amine.svc.cluster.local/loki/api/v1/push"
    headers = {
      "X-Scope-OrgID" = "todo-app-amine",
    }
  }
}
